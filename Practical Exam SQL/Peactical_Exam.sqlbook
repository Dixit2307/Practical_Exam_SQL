CREATE DATABASE Practical_Exam_db;

-- SQLBook: Code
USE Practical_Exam_db;
-- SQLBook: Markup
## Table of Department

-- SQLBook: Code
CREATE TABLE departments (
    department_id INT PRIMARY KEY,
    department_name VARCHAR(100)
);

-- SQLBook: Code
INSERT INTO departments (department_id, department_name) VALUES 
(101, 'Computer Science and Engineering'),
(102, 'Data Science and AI'),
(103, 'Electronics and Communication'),
(104, 'Mechanical Engineering'),
(105, 'Information Technology');

-- SQLBook: Markup
## Table of Students

-- SQLBook: Code
CREATE TABLE students (
    student_id INT PRIMARY KEY,
    name VARCHAR(100),
    dob DATE,
    gender VARCHAR(10),
    email VARCHAR(100),
    phone_number VARCHAR(15),
    address TEXT,
    admission_date DATE,
    department_id INT,
    FOREIGN KEY (department_id) REFERENCES departments(department_id)
);
    
-- SQLBook: Code

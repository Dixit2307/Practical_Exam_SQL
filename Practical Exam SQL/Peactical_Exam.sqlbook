-- SQLBook: Markup
## Table of Cources
-- SQLBook: Code
CREATE TABLE courses (
    course_id INT PRIMARY KEY,
    course_name VARCHAR(50),
    faculty_id INT,
    FOREIGN KEY (faculty_id) REFERENCES faculty(faculty_id) 
);

-- SQLBook: Code
INSERT INTO courses (course_id, course_name, faculty_id) VALUES 
(301, 'Introduction to Computer Science', 501),
(302, 'Machine Learning Basics', 502),
(303, 'Digital Electronics', 503),
(304, 'Thermodynamics', 504),
(305, 'Web Development Fundaments', 505);

-- SQLBook: Markup
## Enrolment Table
-- SQLBook: Code
CREATE TABLE enrollments (
    enrollment_id INT PRIMARY KEY,
    student_id INT,
    course_id INT,
    enrollment_date DATE,
    FOREIGN KEY (student_id) REFERENCES students(student_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
);
-- SQLBook: Code
INSERT INTO enrollments (enrollment_id, student_id, course_id, enrollment_date) VALUES 
(801, 1, 301, '2024-07-20'),
(802, 2, 302, '2024-07-21'),
(803, 3, 301, '2024-07-20'),
(804, 4, 303, '2024-07-22'),
(805, 5, 304, '2024-07-20');

-- SQLBook: Markup
## Attendence Table

-- SQLBook: Code
CREATE TABLE attendance (
    attendance_id INT PRIMARY KEY,
    student_id INT,
    course_id INT,
    attendance_date DATE,
    status VARCHAR(10) CHECK (status IN ('Present', 'Absent', 'Late')),
    FOREIGN KEY (student_id) REFERENCES students(student_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
);
-- SQLBook: Code
INSERT INTO attendance (attendance_id, student_id, course_id, attendance_date, status) VALUES 
(901, 1, 301, '2024-07-21', 'Present'),
(902, 2, 302, '2024-07-21', 'Absent'),
(903, 3, 301, '2024-07-21', 'Late'),
(904, 4, 303, '2024-07-22', 'Present'),
(905, 5, 304, '2024-07-20', 'Present');
-- SQLBook: Markup
## Grades Table
-- SQLBook: Code
CREATE TABLE grades (
    grade_id INT PRIMARY KEY,
    student_id INT,
    course_id INT,
    marks_obtained DECIMAL(5,2),
    grade VARCHAR(5),
    FOREIGN KEY (student_id) REFERENCES students(student_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
);
-- SQLBook: Code
INSERT INTO grades (grade_id, student_id, course_id, marks_obtained, grade) VALUES 
